#!/usr/bin/env bash
#MISE description="Install the 1Password desktop app from the vendor apt repo (1password profile)"
#MISE raw=true
#USAGE flag "--update" help="Upgrade when a newer release exists (default: report only)"
set -eo pipefail

# shellcheck disable=SC2034  # consumed by the logging helpers in lib/profile.sh
TASK_NAME="install:1password"
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib"
# shellcheck source=../lib/profile.sh
source "$LIB/profile.sh"
# shellcheck source=../lib/apt_repo.sh
source "$LIB/apt_repo.sh"

# Follows the manual route in
# https://support.1password.com/install-linux/#debian-or-ubuntu, with two
# deliberate deviations:
#
#  1. deb822 `.sources`, where the page writes a one-line `.list`. Not
#     cosmetic: 1password.postinst migrates a .list to .sources and comments
#     the old one out — which is how a stale, commented-out 1password.save ends
#     up in /etc/apt/sources.list.d (there is one on the author's machine).
#     Writing .sources with the canonical keyring name leaves the postinst
#     nothing to rewrite.
#
#  2. The debsig-verify policy the page installs is omitted. It is inert on
#     Debian-family: /etc/dpkg/dpkg.cfg ships `no-debsig` ("since the
#     distribution is not using embedded signatures, debsig-verify would reject
#     all packages") and debsig-verify is not installed by default, so dpkg
#     never consults the policy. 1password.postinst creates it anyway on first
#     install. Repo/package signature verification is unaffected — that is the
#     Signed-By keyring, which this task does install.
#
# The `op` CLI is NOT installed here: it is a mise [tools] entry in
# config.1password.toml (aqua:1password/cli), which is version-pinnable and
# needs no repo.
require_profile 1password

have apt-get dpkg-query || skip "Not a Debian-family machine"

# The 1Password Debian repo is amd64-only.
[[ "$(dpkg --print-architecture 2>/dev/null)" == "amd64" ]] \
    || skip "1Password's Debian repo has no build for $(dpkg --print-architecture 2>/dev/null) — install from https://1password.com/downloads/linux/"

DO_UPDATE="${usage_update:-false}"
PKGS=(1password)

mapfile -t MISSING < <(apt_pkg_missing "${PKGS[@]}")

if [[ ${#MISSING[@]} -eq 0 ]]; then
    INSTALLED="$(dpkg-query -W -f='${Version}' 1password 2>/dev/null || true)"
    if [[ "$DO_UPDATE" != "true" ]]; then
        ok "1Password $INSTALLED installed"
        info "(upgrade with: mise run install:1password --update)"
        exit 0
    fi
    apt_repo_ensure_known 1password || skip "Could not add the 1Password apt repo"
    apt_pkg_upgrade "${PKGS[@]}" || skip "Could not upgrade 1Password"
    ok_changed "1Password upgraded ($INSTALLED -> $(dpkg-query -W -f='${Version}' 1password 2>/dev/null || true))"
else
    apt_repo_ensure_known 1password || skip "Could not add the 1Password apt repo"
    apt_pkg_install "${MISSING[@]}" || skip "Could not install: ${MISSING[*]}"
    ok_changed "1Password installed ($(dpkg-query -W -f='${Version}' 1password 2>/dev/null || true))"
fi

have op && info "The 'op' CLI is on PATH — enable 'Integrate with 1Password CLI' in the app's settings for biometric unlock"
