#!/usr/bin/env bash
#MISE description="Install Docker Engine from Docker's apt repo (docker profile)"
#MISE raw=true
#USAGE flag "--update" help="Upgrade when a newer release exists (default: report only)"
set -eo pipefail

# shellcheck disable=SC2034  # consumed by the logging helpers in lib/profile.sh
TASK_NAME="install:docker"
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib"
# shellcheck source=../lib/profile.sh
source "$LIB/profile.sh"
# shellcheck source=../lib/apt_repo.sh
source "$LIB/apt_repo.sh"

# Follows https://docs.docker.com/engine/install/ubuntu/ — the five packages
# that make up Engine, the CLI, containerd and the two plugins.
require_profile docker

have apt-get dpkg-query || skip "Not a Debian-family machine"

DO_UPDATE="${usage_update:-false}"
PKGS=(docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)

# Docker's docs tell you to remove these first. We only REPORT them.
#
# The reason is not squeamishness: `docker-ce` declares `Conflicts: docker.io`
# with no matching `Replaces:`, so a plain `apt-get install -y` satisfies the
# conflict by DELETING docker.io — a package the user installed by hand, gone
# with no prompt. apt_pkg_install passes --no-remove precisely so apt refuses
# the transaction instead, and this block explains what to do about it.
CONFLICTS=(docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc)

report_conflicts() {
    local pkg found=()
    for pkg in "${CONFLICTS[@]}"; do
        [[ "$(dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null || true)" == "installed" ]] \
            && found+=("$pkg")
    done
    [[ ${#found[@]} -eq 0 ]] && return 0
    warn "These conflict with Docker Engine and are still installed: ${found[*]}"
    warn "Nothing was removed. Remove them yourself, then re-run this task:"
    warn "    sudo apt-get purge ${found[*]}"
    return 1
}

mapfile -t MISSING < <(apt_pkg_missing "${PKGS[@]}")

if [[ ${#MISSING[@]} -eq 0 ]]; then
    INSTALLED="$(dpkg-query -W -f='${Version}' docker-ce 2>/dev/null || true)"
    if [[ "$DO_UPDATE" != "true" ]]; then
        ok "Docker Engine $INSTALLED installed (${#PKGS[@]} packages)"
        info "(upgrade with: mise run install:docker --update)"
        apt_add_user_group docker
        exit 0
    fi
    apt_repo_ensure_known docker || skip "Could not add the Docker apt repo"
    apt_pkg_upgrade "${PKGS[@]}" || skip "Could not upgrade Docker Engine"
    ok_changed "Docker Engine upgraded ($INSTALLED -> $(dpkg-query -W -f='${Version}' docker-ce 2>/dev/null || true))"
else
    report_conflicts || skip "Refusing to install while conflicting packages are present"
    apt_repo_ensure_known docker || skip "Could not add the Docker apt repo"
    apt_pkg_install "${MISSING[@]}" || skip "Could not install: ${MISSING[*]}"
    ok_changed "Docker Engine installed ($(dpkg-query -W -f='${Version}' docker-ce 2>/dev/null || true))"
fi

# Membership in `docker` is equivalent to root: any member can start a
# container that bind-mounts /. That is the documented trade-off for using the
# CLI without sudo, and selecting the `docker` profile is the consent.
apt_add_user_group docker

have docker && ok "Docker ready: $(docker --version 2>/dev/null || echo 'installed')"
