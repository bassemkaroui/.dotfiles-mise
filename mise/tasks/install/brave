#!/usr/bin/env bash
#MISE description="Install the Brave browser from the vendor apt repo (browsers profile)"
#MISE raw=true
#USAGE flag "--update" help="Upgrade when a newer release exists (default: report only)"
set -eo pipefail

# shellcheck disable=SC2034  # consumed by the logging helpers in lib/profile.sh
TASK_NAME="install:brave"
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib"
# shellcheck source=../lib/profile.sh
source "$LIB/profile.sh"
# shellcheck source=../lib/apt_repo.sh
source "$LIB/apt_repo.sh"

# The keyring MUST be /usr/share/keyrings/brave-browser-archive-keyring.gpg —
# see the registry comment in lib/apt_repo.sh. brave-keyring's postinst greps
# the sources file for exactly that path and, failing to find it, symlinks the
# key into /etc/apt/trusted.gpg.d/ where it would be trusted for every repo on
# the machine.
require_profile browsers

have apt-get dpkg-query || skip "Not a Debian-family machine"

DO_UPDATE="${usage_update:-false}"
PKGS=(brave-browser)

mapfile -t MISSING < <(apt_pkg_missing "${PKGS[@]}")

if [[ ${#MISSING[@]} -eq 0 ]]; then
    INSTALLED="$(dpkg-query -W -f='${Version}' brave-browser 2>/dev/null || true)"
    if [[ "$DO_UPDATE" != "true" ]]; then
        ok "Brave $INSTALLED installed"
        info "(upgrade with: mise run install:brave --update)"
        exit 0
    fi
    apt_repo_ensure_known brave || skip "Could not add the Brave apt repo"
    apt_pkg_upgrade "${PKGS[@]}" || skip "Could not upgrade Brave"
    ok_changed "Brave upgraded ($INSTALLED -> $(dpkg-query -W -f='${Version}' brave-browser 2>/dev/null || true))"
else
    apt_repo_ensure_known brave || skip "Could not add the Brave apt repo"
    apt_pkg_install "${MISSING[@]}" || skip "Could not install: ${MISSING[*]}"
    ok_changed "Brave installed ($(dpkg-query -W -f='${Version}' brave-browser 2>/dev/null || true))"
fi
